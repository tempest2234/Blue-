# --- Required ---
ALPACA_KEY_ID=your-key-id
ALPACA_SECRET_KEY=your-secret-key
DASHBOARD_PASSWORD=pick-a-long-password

# --- Paper vs real money ---
# Paper trading (fake money) is the default. For real money you need BOTH lines:
# ALPACA_PAPER=false
# LIVE_TRADING_CONFIRM=I_ACCEPT_THE_RISK

# --- What to trade ---
SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,GOOGL,META
TIMEFRAME=1Hour
CHECK_INTERVAL_MIN=15

# --- Risk limits ---
MAX_POSITION_PCT=10
MAX_OPEN_POSITIONS=5
STOP_LOSS_PCT=3
TAKE_PROFIT_PCT=6
MAX_DAILY_LOSS_PCT=3

# --- Strategy ---
FAST_SMA=20
SLOW_SMA=50
RSI_PERIOD=14
RSI_MAX_ENTRY=70
RSI_EXIT=80
CROSS_LOOKBACK=3

# --- Optional phone push notifications (install the free ntfy app, subscribe to this topic) ---
# Pick a long random topic name; anyone who knows it can read your alerts.
# NTFY_TOPIC=my-trade-bot-x7k2p9q4
